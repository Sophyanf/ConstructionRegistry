<UserControl x:Class="ConstructionRegistry.Controls.AppHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#CDE1EC" Padding="10" MouseLeftButtonDown="TitleBar_MouseDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="{StaticResource AppLogo}"
                   Height="40" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       FontSize="18" FontWeight="SemiBold" Foreground="#2C3E50"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource BaseHeaderBtnStyle}" ToolTip="Свернуть"
                        Click="BtnMinimize_Click" Margin="10,0,10,0">
                    <Path Data="M4,14 L12,14 L20,14" Stroke="#F0F5F9" StrokeThickness="3" Stretch="Uniform"/>
                </Button>
                <Button Style="{StaticResource BaseHeaderBtnStyle}" ToolTip="Развернуть"
                        Click="BtnMaximize_Click" Margin="10,0,10,0">
                    <Path Data="M4,4 L20,4 L20,20 L4,20 Z" Stroke="#F0F5F9" StrokeThickness="3" Stretch="Uniform"/>
                </Button>
                <Button Style="{StaticResource BaseHeaderBtnStyle}" ToolTip="Закрыть"
                        Click="BtnClose_Click" Margin="10,0,10,0">
                    <Path Data="M4,4 L20,20 M4,20 L20,4" Stroke="#F0F5F9" StrokeThickness="3" Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>