<UserControl x:Class="ConstructionRegistry.Controls.HeaderPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ConstructionRegistry.Controls"
             Height="60">

    <UserControl.Resources>
        <!-- Шаблон кнопки (без дублирования) -->
        <ControlTemplate x:Key="HeaderButtonTemplate" TargetType="Button">
            <Border x:Name="border" Background="{TemplateBinding Background}" Padding="5">
                <TextBlock x:Name="icon"
                           Text="{TemplateBinding Content}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="16"
                           Foreground="{TemplateBinding Foreground}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Background" Value="#4DFFFFFF"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="border" Property="Background" Value="#99FFFFFF"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="BaseHeaderBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CFDEEC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource HeaderButtonTemplate}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Область перетаскивания (вся ширина минус место под кнопки) -->
        <Border Background="Transparent"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                Margin="0,0,100,0"/>

        <DockPanel LastChildFill="False">
            <!-- Логотип (заглушка) -->
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="20,0,0,0">
                <TextBlock Text="LOGO" FontSize="24" Foreground="White"/>
            </StackPanel>

            <!-- Кнопки справа -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Кнопки теперь просто вызывают статические методы -->
                <Button Style="{StaticResource BaseHeaderBtnStyle}"
                        Content="&#xE890;"
                        Margin="10,0,5,0"
                        ToolTip="Свернуть"
                        Click="BtnMinimize_Click"/>

                <Button Style="{StaticResource BaseHeaderBtnStyle}"
                        Content="&#xE739;"
                        Margin="0,0,5,0"
                        ToolTip="Развернуть"
                        Click="BtnMaximize_Click"/>

                <Button Style="{StaticResource BaseHeaderBtnStyle}"
                        Content="&#xE8BB;"
                        Margin="0,0,0,0"
                        ToolTip="Закрыть"
                        Click="BtnClose_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
