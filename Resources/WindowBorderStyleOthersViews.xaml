<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fa="http://schemas.fontawesome.io/icons/">

    <!-- Кисть для фона окна -->
    <ImageBrush x:Key="WindBackgraund" ImageSource="pack://application:,,,/Resources/fon1.jpg"/>

    <BitmapImage x:Key="AppLogo" UriSource="pack://application:,,,/Resources/logoNGM.png"/>

    <!-- Стиль окна -->
    <Style x:Key="WindowStyle" TargetType="Window">
        <Setter Property="AllowsTransparency" Value="True"/>
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="AllowDrop" Value="True"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="TextElement.Foreground" Value="#1E90FF"/>
        <Setter Property="Background" Value="{StaticResource WindBackgraund}"/>
    </Style>

    <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           Padding="5"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <!-- Важно: увеличиваем высоту шапки, иначе текст обрежется -->
        <Setter Property="Height" Value="60"/>
        <Setter Property="MinWidth" Value="50"/>
    </Style>


    <!-- Общий стиль кнопок (для обычных кнопок в формах) -->
    <Style TargetType="Button">
        <Setter Property="Width" Value="120"/>
        <Setter Property="Height" Value="35"/>
        <Setter Property="Margin" Value="10,5,10,5"/>
        <Setter Property="Background" Value="#CAD9EC"/>
        <!-- Исправлено: убрано дублирование BorderThickness -->
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="#95C0D8"/>
        <Setter Property="Padding" Value="-4"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Стили для полей ввода и комбобоксов (оставлены как у тебя) -->
    <Style TargetType="TextBox">
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="#95C0D8"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="FontFamily" Value="Times New Roman"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="#6397CE"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="FontFamily" Value="Times New Roman"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ШАБЛОН ДЛЯ КНОПОК ШАПКИ  -->
    <Style x:Key="BaseHeaderBtnStyle" TargetType="Button">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="#4d95cf"/> 
        <Setter Property="BorderThickness" Value="5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
