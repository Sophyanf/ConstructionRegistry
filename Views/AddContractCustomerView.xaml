<Window x:Class="ConstructionRegistry.Views.AddContractCustomerView"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:local="clr-namespace:ConstructionRegistry.Views"
                      xmlns:vm="clr-namespace:ConstructionRegistry.ViewModels"
                      mc:Ignorable="d"
                      Style="{StaticResource WindowStyle}"
                      Title="Добавить договор"
                      Height="450" 
                      Width="550">
    <Grid>
        <DockPanel>
            <Border Background="White" DockPanel.Dock="Top" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
                <Grid HorizontalAlignment="Stretch">
                    <Label Content="Договор" Foreground="Blue" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="10,0"/>
                 
                </Grid>
            </Border>
            <StackPanel Orientation="Vertical" Background="White" Margin="20">
                <Label Height="50" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Content="Создание договора с контрагентом"
                       FontSize="18" FontWeight="SemiBold"/>
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <Label VerticalAlignment="Center" Margin="10,20,0,0"
                               Width="150" Content="Контрагент" VerticalContentAlignment="Center"/>
                        <ComboBox Width="250" Margin="35,20,15,0" Height="30"
                                 ItemsSource="{Binding Kontragents}"
                                 SelectedItem="{Binding Customer, UpdateSourceTrigger=PropertyChanged}"
                                 DisplayMemberPath="KontragentShortName"
                                 HorizontalAlignment="Left"
                                 BorderBrush="Aqua"
                                 BorderThickness="1"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label VerticalAlignment="Center" Margin="10,20,0,0"
                               Width="150" Content="Номер договора" VerticalContentAlignment="Center"/>
                        <TextBox Text="{Binding ContractCustomerNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="35,20,15,0" Width="250" Height="30"
                                 HorizontalAlignment="Left" 
                                 BorderBrush="Aqua"
                                 BorderThickness="1"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label VerticalAlignment="Center" Margin="10,20,0,0"
                               Width="150" Content="Дата договора" VerticalContentAlignment="Center"/>
                        <DatePicker SelectedDate="{Binding ContractCustomerData}"
                                    Margin="35,20,15,0" Width="250" Height="30"
                                    HorizontalAlignment="Left"
                                    BorderBrush="Aqua"
                                    BorderThickness="1"/>
                    </StackPanel>
                </StackPanel>
                <Button Margin="0,40" Content="Создать" Width="80" Height="40"
                        HorizontalAlignment="Center"
                        Command="{Binding AddNewContractCustomer}"
                        Background="#007ACC" Foreground="White"
                        BorderThickness="0" Padding="10,5"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
