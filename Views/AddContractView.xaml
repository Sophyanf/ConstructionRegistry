<Window x:Class="ConstructionRegistry.Views.AddContracttView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ConstructionRegistry.Views"
        mc:Ignorable="d"
          WindowStyle="None"
        xmlns:vm="clr-namespace:ConstructionRegistry.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:KontragentAddVM}"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
		 Style="{StaticResource WindowStyle}"
        Title="AddKontragentView" Height="400" Width="500">

    <Window.DataContext>

        <vm:KontragentAddVM x:Name="KontragentAddVM"></vm:KontragentAddVM>
    </Window.DataContext>

    <DockPanel >
        <Border Background="White" DockPanel.Dock="Top">
            <Grid HorizontalAlignment="Stretch" >
                <Label Content="Договор"
                       Foreground="Blue"
                       FontWeight="Bold"
                       />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            >
                    <Button Style="{StaticResource ResourceKey=MinimizeBtnStyle}"
                            Command="{Binding WindowMinimizeCommand}"
                            />
                    <Button Style="{StaticResource ResourceKey=MaximizeBtnStyle}"
                            Command="{Binding WindowMaximizeCommand}"
                            />
                    <Button Style="{StaticResource ResourceKey=CloseWindowBtnStyle}"
                            Command="{Binding CloseWindowCommand}"
                            />
                </StackPanel>
            </Grid>
        </Border>


        <StackPanel Orientation="Vertical" Background="White"  Margin="20, 20, 20, 20">



            <Label
                Height="50"
                HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                    Content="Договор"
                />

            <StackPanel Orientation="Vertical" >

                <StackPanel Orientation="Horizontal"  >
                    <Label
                     VerticalAlignment="Center"
					 Margin="10, 20, 0, 0"
                    Content="Контрагент"
					 Width="150"
                />
                    <ComboBox Width="250"
						  Margin="35, 20, 15, 0"
                                  
					 ItemsSource="{Binding Kontragents}"
						   DisplayMemberPath="KontragentShortName"
						   SelectedItem="{Binding SelectKontragent}"
					 Height="30"
					 HorizontalAlignment="Left"
					 BorderBrush="Aqua"
						   SelectedIndex="0">
                    </ComboBox>
                </StackPanel >
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" >
                    <Label
						 Margin="10, 20, 0, 0"
                     VerticalAlignment="Center"
						 Width="150"
                    Content="Номер договора"
                />
                    <TextBox
                          Text="{Binding KontragentShortName}"
                    Margin="35, 20, 15, 0"
                    Width="250"
                    Height="30"
                    HorizontalAlignment="Right"
                    BorderBrush="Aqua"
                />
                </StackPanel >
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" >
                    <Label
						 Margin="10, 20, 0, 0"
					 Width="150"
                     VerticalAlignment="Center"
                    Content="Дата договора"
                />
                    <DatePicker Name ="dpFinish"
                            SelectedDate="{Binding EndDate}"
				Height="30"        
                  Margin="35, 20, 15, 0"
                    Width="250"
                />
                </StackPanel >


            </StackPanel >
            <Button
               Margin="0, 40"
                    Content="Создать"
                    Width="80"
                    Height ="40"
                    Command="{Binding AddNewKontragent}"
                />
        </StackPanel>
    </DockPanel>
</Window>
