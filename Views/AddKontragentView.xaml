<local:BaseWindowView x:Class="ConstructionRegistry.Views.AddKontragentView"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:local="clr-namespace:ConstructionRegistry.Views"
                      mc:Ignorable="d"
                      Title="Добавить контрагента"
                      Height="700" Width="600">
    <StackPanel Orientation="Vertical" Background="Transparent" Grid.RowSpan="2">
        <DockPanel Background="Transparent" HorizontalAlignment="Stretch" Height="60" VerticalAlignment="Center">
            <StackPanel Margin="20,15,20,0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Image Source="pack://application:,,,/Resources/logoNGM.png" />
            </StackPanel>
            <StackPanel Margin="0,15,20,0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource ResourceKey=MinimizeBtnStyle}" Command="{Binding WindowMinimizeCommand}" />
                <Button Style="{StaticResource ResourceKey=MaximizeBtnStyle}" Command="{Binding WindowMaximizeCommand}" />
                <Button Style="{StaticResource ResourceKey=CloseWindowBtnStyle}" Command="{Binding CloseWindowCommand}" />
            </StackPanel>
        </DockPanel>
        <StackPanel Orientation="Vertical" Background="White" Margin="20,15,20,20">
            <Label Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" Content="Введите данные контрагента" />
            <UniformGrid Rows="5" Columns="2" HorizontalAlignment="Left">
                <Label VerticalAlignment="Center" Content="Наименование контрагента" />
                <TextBox Text="{Binding KontragentName, UpdateSourceTrigger=PropertyChanged}"
                         Width="350" Height="25" HorizontalAlignment="Right" BorderBrush="Aqua" />
                <Label VerticalAlignment="Center" Content="Краткое наименование контрагента" />
                <TextBox Text="{Binding KontragentShortName, UpdateSourceTrigger=PropertyChanged}"
                         Width="350" Height="25" HorizontalAlignment="Right" BorderBrush="Aqua" />
                <Label VerticalAlignment="Center" Content="Адрес" />
                <TextBox Text="{Binding KontragentAdress, UpdateSourceTrigger=PropertyChanged}"
                         Width="350" Height="25" HorizontalAlignment="Right" BorderBrush="Aqua" />
                <Label VerticalAlignment="Center" Content="ИНН" />
                <TextBox Text="{Binding KontragenINN, UpdateSourceTrigger=PropertyChanged}"
                         Width="350" Height="25" HorizontalAlignment="Right" BorderBrush="Aqua" />
                <Label VerticalAlignment="Center" Content="Плательщик НДС" />
                <CheckBox IsChecked="{Binding IsVatPayer, UpdateSourceTrigger=PropertyChanged}" Margin="0,20" />
            </UniformGrid>
            <Button Margin="0,20" Content="Создать" Width="80" Height="40" Command="{Binding AddNewKontragent}" />
        </StackPanel>
    </StackPanel>
</local:BaseWindowView>
