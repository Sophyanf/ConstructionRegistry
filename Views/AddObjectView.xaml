<Window x:Class="ConstructionRegistry.Views.AddObjectView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ConstructionRegistry.ViewModels"
        mc:Ignorable="d"
         Style="{StaticResource WindowStyle}"
        Title="Добавить объект"
        Height="880"
        Width="750">
    <Window.DataContext>
        <vm:ObjectAddViewVM/>
    </Window.DataContext>

    <Grid Background="Transparent" MouseDown='OnDragMoveWindow'>
        <Grid.RowDefinitions>
            <RowDefinition Height="0*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width='*' />
            <ColumnDefinition Width='Auto' />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Vertical" Background="Transparent" Grid.RowSpan="2">
            <DockPanel  Background="Transparent" HorizontalAlignment ="Stretch" Height="60" VerticalAlignment="Center">
                <StackPanel  Margin="20,15,20,0" Orientation="Horizontal"  HorizontalAlignment ="Left" VerticalAlignment="Top">
                    <Image Source ="pack://application:,,,/Resources/logoNGM.png" />

                </StackPanel>
                <StackPanel  Margin="0,15,20,0" Orientation="Horizontal"  HorizontalAlignment ="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource ResourceKey=MinimizeBtnStyle}"
                  Command="{Binding WindowMinimizeCommand}"
                  />
                    <Button Style="{StaticResource ResourceKey=MaximizeBtnStyle}"
                  Command="{Binding WindowMaximizeCommand}"
                  />
                    <Button Style="{StaticResource ResourceKey=CloseWindowBtnStyle}"
                  Command="{Binding CloseWindowCommand}"
                  />
                </StackPanel>
            </DockPanel>


            <StackPanel Orientation="Vertical"   Margin ="20, 15, 20 , 20" Background="White"  >
                <Label
                    Height="50"
                    HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                    Content="Данные объекта" 
                />

                <StackPanel Orientation="Horizontal" >
                    <Label
                    Width="250"
                    HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                    Content="Наименование объекта" 
                />
                    <TextBox 
                         Text="{Binding ObjName}"
                    Width="425"
                    Height="90"
                    HorizontalAlignment="Right" 
                />
                </StackPanel>



                <StackPanel Orientation="Horizontal"  Margin="0, 20, 0, 0">
                    <Label Width="250"
                    HorizontalAlignment="Left"
                    Content="Заказчик" 
                />
                    <ComboBox Width="300"
                                  
                    ItemsSource="{Binding Kontragents}" 
                          DisplayMemberPath="KontragentShortName"
                          SelectedItem="{Binding SelectKontragent}"
                    Height="30"
                    HorizontalAlignment="Left"
                    BorderBrush="Aqua"  
                          SelectedIndex="0">
                    </ComboBox>

                    <Button 
                       Width="90"
                        Height="30"
                        Margin="30,0"
                        HorizontalAlignment="Center"  
                        VerticalAlignment="Center"
                        Content="Создать"
                        Command="{Binding AddNewKontragent }"
                        
                        >
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0, 20, 0, 0">
                    <Label Width="250"
                    HorizontalAlignment="Left"
                    Content="Договор" 
                />
                    <ComboBox Width="300"
                                  
                    ItemsSource="{Binding Kontragents}" 
                          DisplayMemberPath="KontragentShortName"
                          SelectedItem="{Binding Contract}"
                    Height="30"
                    HorizontalAlignment="Left"
                    BorderBrush="Aqua"  
                          SelectedIndex="0">
                    </ComboBox>

                    <Button 
                       Width="90"
                        Height="30"
                        Margin="30,0"
                        HorizontalAlignment="Center"  
                        VerticalAlignment="Center"
                        Content="Создать"
                        Command="{Binding ConstructionOrganizationSub }"
                        
                        >
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0, 20, 0, 0">
                    <Label Width="250"
                    HorizontalAlignment="Left"
                    Content="Субподрядчик" 
                />
                    <ComboBox Width="300"
                                  
                    ItemsSource="{Binding Kontragents}" 
                          DisplayMemberPath="KontragentShortName"
                          SelectedItem="{Binding SelectKontragent}"
                    Height="25"
                    HorizontalAlignment="Left"
                    BorderBrush="Aqua"  
                          SelectedIndex="0">
                    </ComboBox>

                    <Button 
                       Width="90"
                        Height="30"
                        Margin="30,0"
                        HorizontalAlignment="Center"  
                        VerticalAlignment="Center"
                        Content="Создать"
                        Command="{Binding AddNewKontragent }"
                        
                        >
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0, 20, 0, 0">
                    <Label 
        Width="250"
    HorizontalAlignment="Left"
    Content="Дата заявки" 
/>
                    <DatePicker Name ="dpFinish"
            SelectedDate="{Binding StartDate }"
            
    Width="200"
    Height="30"
    HorizontalAlignment="Left"
/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Margin="0, 20, 0, 0">
                    <Label 
                        Width="250"
                    HorizontalAlignment="Left"
                    Content="Дата закрытия" 
                />
                    <DatePicker 
                            SelectedDate="{Binding EndDate}"
                            
                    Width="200"
                    Height="30"
                    HorizontalAlignment="Left"
                />
                </StackPanel>





                <StackPanel Orientation="Horizontal" Margin="0, 20, 0, 0" >
                    <Label
                    Width="250"
                    HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                    Content="Стоимость объекта" 
                />
                    <TextBox  PreviewTextInput="NumberValidationTextBox"
                         Text="{Binding ObjCost}"
                    Width="425"
                    Height="30"
                    HorizontalAlignment="Right" 
                />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0, 20, 0, 0" >
                    <Label
    Width="250"
    HorizontalAlignment="Left"
     VerticalAlignment="Center"
    Content="Коэффициент генподряда" 
/>
                    <TextBox  PreviewTextInput="NumberValidationTextBox"
         Text="{Binding SubcontractingCoefficients}"
    Width="100"
    Height="30"
    HorizontalAlignment="Right"
/>
                </StackPanel>


                <StackPanel Orientation="Horizontal" Margin="0, 20, 0, 0">
                    <Label Width="250"
        HorizontalAlignment="Left"
        Content="Представитель заказчика" 
    />
                    <ComboBox Width="300"
                                  
                    ItemsSource="{Binding Kontragents}" 
                          DisplayMemberPath="KontragentShortName"
                          SelectedItem="{Binding SelectKontragent}"
                    Height="25"
                    HorizontalAlignment="Left"
                    BorderBrush="Aqua"  
                          SelectedIndex="0" SelectionChanged="ComboBox_SelectionChanged">
                    </ComboBox>

                    <Button 
                       Width="90"
                        Height="30"
                        Margin="30,0"
                        HorizontalAlignment="Center"  
                        VerticalAlignment="Center"
                        Content="Создать"
                        Command="{Binding AddNewKontragent }"
                        
                        >
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0, 20, 0, 0" >
                        <Label
                             Width="250"
                             HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                             Content="Комментарий" 
                         />
                                        <TextBox 
                                  Text="{Binding ObjName}"
                             Width="425"
                             Height="30"
                             HorizontalAlignment="Right"
                         /> 
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0, 20, 0, 0"  HorizontalAlignment="Center"   >
                    <Button 
                       Width="150"
                        Height="30"
                        HorizontalAlignment="Center"  
                        VerticalAlignment="Top"
                        Content="Создать объект"
                        Command="{Binding AddNewConctrObject}"
                        
                        >
                    </Button>
                </StackPanel>

            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
