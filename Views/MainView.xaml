<Window x:Class="ConstructionRegistry.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ConstructionRegistry.Controls"
        xmlns:viewmodels="clr-namespace:ConstructionRegistry.ViewModels"
        mc:Ignorable="d"
        Style="{StaticResource WindowStyle}"
        Width="1500" Height="900">
    <Grid Background="Transparent">
        <!-- Строки: шапка (60px) и контент -->
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Шапка (переиспользуемый контрол) -->
        <controls:AppHeader Grid.Row="0" Title="База объектов"/>
        <!-- Основная область -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Кнопки управления -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Создать" Command="{Binding AddNewObjectDB}" Margin="0,0,10,0"/>
                <Button Content="Тест" Command="{Binding AddPersonDB}" Margin="0,0,10,0"/>
                <Button Content="Не работает"/>
            </StackPanel>
            <!-- Таблица объектов -->
            <DataGrid Grid.Row="1"
                      AutoGenerateColumns="False"
                      HorizontalGridLinesBrush="#CAD9EC"
                      RowBackground="White"
                      AlternatingRowBackground="White"
                      ItemsSource="{Binding ObjectsList}"
                      SelectedItem="{Binding SelectObject}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Объект" Binding="{Binding ObjectName}" Width="400"/>
                    <DataGridTextColumn Header="Заказчик" Binding="{Binding Customer}" Width="200"/>
                    <DataGridTextColumn Header="Договор" Binding="{Binding Contract}" Width="150"/>
                    <DataGridTextColumn Header="Субподрядчик" Binding="{Binding ConstructionOrganizationSub}" Width="200"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding ProjectForObject}" Width="100"/>
                    <DataGridTextColumn Header="Дата закрытия" Binding="{Binding EndDate}" Width="100"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding CostOfObject}" Width="100"/>
                    <DataGridTextColumn Header="Дата заявки" Binding="{Binding DateOfApplication}" Width="100"/>
                    <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="100"/>
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Копировать"/>
                        <MenuItem Header="Вставить"/>
                        <MenuItem Header="Вырезать"/>
                        <MenuItem Header="Удалить" Command="{Binding RemoveObjectDB}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </Grid>
    </Grid>
</Window>