<Window x:Class="ConstructionRegistry.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ConstructionRegistry.Views"
        mc:Ignorable="d"
        xmlns:vm="clr-namespace:ConstructionRegistry.ViewModels"
        Style="{StaticResource WindowStyle}" 
        Height = "{Binding  ScreenHeight}" Width="{Binding ScreenWidth}"
        WindowStartupLocation="Manual" 
        Left="0" Top="0"
         >


    <Grid Background="Transparent" >
        <Grid.RowDefinitions>
            <RowDefinition Height="0*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width='*' />
            <ColumnDefinition Width='Auto' />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Vertical" Background="Transparent" Grid.RowSpan="2">
            <DockPanel  Background="Transparent" HorizontalAlignment ="Stretch" Height="60" VerticalAlignment="Center">
                <StackPanel  Margin="20,15,20,0" Orientation="Horizontal"  HorizontalAlignment ="Left" VerticalAlignment="Top">
                  
                    
                </StackPanel>
                <Image Source ="pack://application:,,,/Resources/logoNGM.png" />
           
            </DockPanel>
            
            
            <StackPanel Orientation="Horizontal" Height="50"  Margin="20,15,20,0" Background="White">
                <Button
                   Content="Создать" 
                   Command="{Binding AddNewObjectDB}"
                />

                <Button
                    Content="Тест" 
                    Command="{Binding AddPersonDB}"
                />
                <Button
                    Content="Не работает" 
                />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin ="20, 0, 20 , 20" Background="White" Height ="{Binding MainStackPanel}">
                <StackPanel Orientation="Vertical"   >
                    <DataGrid AutoGenerateColumns="False" HorizontalGridLinesBrush="#CAD9EC"
                              RowBackground="White" AlternatingRowBackground="White"
                              ItemsSource="{Binding ObjectsList}" SelectedItem="{Binding SelectObject}">

                       
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Объект" Binding="{Binding Path=ObjectName}" Width="300" >
                                <DataGridTextColumn.ElementStyle>
                                     <Style TargetType="TextBlock">
                                         <Setter Property="TextWrapping" Value="Wrap"></Setter>
                                     </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Заказчик" Binding="{Binding Path=Customer}" Width="100" />
                            <DataGridTextColumn Header="Статус"  Binding="{Binding Path=ProjectForObject}" Width="100" />
                            <DataGridTextColumn Header="Проектная организация" Binding="{Binding Path=ProjectForObject.ProjektСompany.KontragentShortName}" Width="50" />
                        </DataGrid.Columns>
                        
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Копировать"></MenuItem>
                                <MenuItem Header="Вставить"></MenuItem>
                                <MenuItem Header="Вырезать"></MenuItem>
                                <MenuItem Header="Удалить" Command="{Binding RemoveObjectDB}"></MenuItem >
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        
                    </DataGrid>

                  


                </StackPanel>
            </StackPanel>
        </StackPanel>
  </Grid>
</Window>
