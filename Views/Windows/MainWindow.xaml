<Window x:Class="ConstructionRegistry.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ConstructionRegistry.Views"
        Style="{StaticResource WindowStyle}"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">

    <Grid>
        <!-- 1. Добавляем шапку с кнопками -->
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <!-- Высота шапки -->
            <RowDefinition Height="*"/>
            <!-- Остальное место — контент -->
        </Grid.RowDefinitions>

        <!-- Панель заголовка (кнопки управления окном) -->
        <Border Grid.Row="0" 
                Background="#2C3E50" 
                Padding="10"
                MouseLeftButtonDown="TitleBar_MouseDown">

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Свернуть -->
                <Button Style="{StaticResource BaseHeaderBtnStyle}"
                        Content="_"
                        ToolTip="Свернуть"
                        Click="BtnMinimize_Click"
                        Margin="0,0,10,0"/>

                <!-- Развернуть/Восстановить -->
                <Button Style="{StaticResource BaseHeaderBtnStyle}"
                        Content="□"
                        ToolTip="Развернуть"
                        Click="BtnMaximize_Click"
                        Margin="0,0,10,0"/>

                <!-- Закрыть -->
                <Button Style="{StaticResource BaseHeaderBtnStyle}"
                        Content="✕"
                        Foreground="Red"
                        ToolTip="Закрыть"
                        Click="BtnClose_Click"/>
            </StackPanel>
        </Border>

        <!-- 2. Ваш существующий контент (таблица, кнопки Создать/Тест и т.д.) -->
        <Grid Grid.Row="1">
            <!-- Сюда вставьте ваш текущий код с кнопками "Создать", "Тест" и DataGrid -->
            <StackPanel Orientation="Horizontal" Margin="10">
                <Button Content="Создать" Padding="10,5" Margin="0,0,10,0"/>
                <Button Content="Тест" Padding="10,5" Margin="0,0,10,0"/>
                <Button Content="Не работает" Padding="10,5"/>
            </StackPanel>

            <DataGrid Grid.Row="1" Margin="10,15,10,10" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Объект" Width="*"/>
                    <DataGridTextColumn Header="Заказчик" Width="*"/>
                    <DataGridTextColumn Header="Статус" Width="*"/>
                    <DataGridTextColumn Header="Проектная орган" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
